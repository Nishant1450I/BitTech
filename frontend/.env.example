# Dead Infrastructure Mapper - Frontend Configuration
# Base URL for the FastAPI backend service
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Set to true when backend is running to switch service layer from local store to live API
NEXT_PUBLIC_ENABLE_REAL_API=false

# Default map view center coordinates and zoom level
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=19.9975
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=73.7898
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=13
