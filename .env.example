# ==========================================
# Dead Infrastructure Mapper - Environment Configuration
# ==========================================

# --- Backend Configuration ---
PROJECT_NAME="Dead Infrastructure Mapper API"
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000"]

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dead_infra_db

# Security & JWT
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
UPLOAD_DIR=./uploads

# AI Service Settings
AI_MOCK_MODE=true

# --- Frontend Configuration ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=12.9716
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=77.5946
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=14
